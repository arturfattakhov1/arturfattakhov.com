---
import { Image } from 'astro:assets';
import { getProfessionalCredentials } from '../data/credentials';
import type { Language } from '../i18n/config';
import Container from './Container.astro';

interface Props { lang: Language; }
const { lang } = Astro.props;
const credentials = getProfessionalCredentials(lang);
const copy = {
  ru: {
    introduction: 'Избранные документы подтверждают дополнительную подготовку в организации исследований и управлении профессиональными проектами.',
    open: 'Открыть увеличенное изображение',
  },
  en: {
    introduction: 'Selected documents confirm additional training in research organisation and professional project management.',
    open: 'Open larger image',
  },
} as const;
---

<Container size="wide">
  <p class="section-lead-compact">{copy[lang].introduction}</p>
  <div class="professional-credentials">
    {credentials.map((credential) => (
      <article class="professional-credential" data-professional-credential={credential.id}>
        <a
          class="professional-credential__preview"
          href={credential.image.src}
          target="_blank"
          rel="noopener"
          aria-label={`${copy[lang].open}: ${credential.title}`}
        >
          <Image
            src={credential.image}
            alt={credential.alt}
            width={credential.image.width}
            height={credential.image.height}
            widths={[360, 540, 720, 960]}
            sizes="(max-width: 42rem) calc(100vw - 2rem), (max-width: 72rem) 45vw, 24rem"
            layout="constrained"
            quality={86}
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="professional-credential__body">
          <h3>{credential.title}</h3>
          <p>{credential.organization}</p>
          <dl>
            <div><dt>{lang === 'ru' ? 'Дата' : 'Date'}</dt><dd>{credential.date}</dd></div>
            <div><dt>{lang === 'ru' ? 'Язык' : 'Language'}</dt><dd>{credential.documentLanguage}</dd></div>
          </dl>
        </div>
      </article>
    ))}
  </div>
</Container>
